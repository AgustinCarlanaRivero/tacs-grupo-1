# Plantilla de variables de entorno. Copiar a `.env.dev` y `.env.prod`
# (ambos ignorados por git) y completar los valores reales.

NODE_ENV=
PORT=
URL=

# MongoDB configuration
MONGO_URI=
MONGODB_DB_NAME=

# Auth0 API configuration
AUTH0_ISSUER_BASE_URL=
AUTH0_AUDIENCE=

# Local development auth bypass (never enable in production)
DISABLE_AUTH=
MOCK_USER_ID=
MOCK_USER_ROLE=

# Plantilla de variables de entorno. Copiar a `.env.dev` y `.env.prod`
# (ambos ignorados por git) y completar los valores reales.

NODE_ENV=
PORT=
URL=

# MongoDB configuration
MONGO_URI=
MONGODB_DB_NAME=

# Auth0 API configuration
AUTH0_ISSUER_BASE_URL=
AUTH0_AUDIENCE=

# Local development auth bypass (never enable in production)
DISABLE_AUTH=
MOCK_USER_ID=
MOCK_USER_ROLE=

# Telegram bot (opcional; si falta, el bot no arranca)
TELEGRAM_BOT_TOKEN=
# Base del front para armar el link de login del bot
FRONTEND_URL=
# Secreto HMAC para firmar el token de vinculación (si falta, se usa TELEGRAM_BOT_TOKEN)
TELEGRAM_LINK_SECRET=

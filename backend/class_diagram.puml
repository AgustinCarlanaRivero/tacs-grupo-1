@startuml class_diagram

enum Category {
  REGULAR
  SHINY
}

enum UserType {
  REGULAR
  ADMIN
}

enum OfferState {
  PENDING
  APPROVED
  REJECTED
}

enum PostState {
  ACTIVE
  COMPLETED
  CLOSED
}

class NationalTeam {
  -name: string
}

class Club {
  -name: string
}

class Player {
  -name: string
  -nationalTeam: NationalTeam
  -club: Club
}

class Sticker {
  -number: number
  -player: Player
  -category: Category
  -description: string
}

class User {
  -firstName: string
  -lastName: string
  -username: string
  -email: string
  -type: UserType
}

class Collector {
  -user: User
  -collectionItems: CollectionItem[]
  -missingStickers: Sticker[]
  -reputation: number
}

class Rating {
  -reviewer: User
  -reviewee: User
  -score: number
  -comment: string
  -createdAt: Date
}

interface CollectionItem { 
  -sticker: Sticker
  -quantity: number
}

class Offer {
  -collector: Collector
  -offerState: OfferState
  -createdAt: Date
  -collectionItems: CollectionItem[]
}

abstract class Post {
  -collector: Collector
  -sticker: Sticker
  -tradeState: PostState
  -offers: Offer[]
}

class DirectTrade

class Auction {
  -createdAt: Date
  -endsAt: Date
  -minimumRequirement: CollectionItem
  +duration(): number
}

NationalTeam <-- Player
Club <-- Player

Player <-- Sticker
Category <-- Sticker

User <-- Collector
Sticker <-- Collector

User <-- Rating

UserType <-- User

Collector <-- Offer
CollectionItem <-- Offer
OfferState <-- Offer

Collector <-- Post
Sticker <-- Post
Offer <-- Post
PostState <-- Post

Post <|-- DirectTrade
Post <|-- Auction

CollectionItem <-- Auction

@enduml
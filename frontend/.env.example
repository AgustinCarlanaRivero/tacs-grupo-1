# Plantilla de variables de entorno del frontend. Copiar a `.env.local`
# (ignorado por git) y completar los valores reales.
# Todas llevan prefijo NEXT_PUBLIC_ porque se usan en el cliente.

# Base del backend
NEXT_PUBLIC_API_URL=

# Auth0 (SPA)
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=

# Usuario del bot de Telegram para el botón "Volver a Telegram" (sin @)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Bypass de auth para desarrollo local (nunca en producción)
NEXT_PUBLIC_DISABLE_AUTH=
NEXT_PUBLIC_MOCK_USER_ID=
NEXT_PUBLIC_MOCK_USER_ROLE=
